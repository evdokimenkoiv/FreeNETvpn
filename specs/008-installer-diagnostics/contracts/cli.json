    "HTTPS_DNS",
    "HTTPS_CONNECT",
    "HTTPS_TIMEOUT",
    "HTTPS_TLS",
    "HTTPS_BACKEND",
    "HTTPS_AUTH",
    "HTTPS_RESPONSE",
    "INSTALL_STAGE",
    "IMAGE_DISK",
    "IMAGE_DNS",
    "IMAGE_TLS",
    "IMAGE_LIMIT",
    "IMAGE_NOT_FOUND",
    "IMAGE_AUTH",
    "COMPOSE_VERSION",
    "IMAGE_NETWORK",
    "IMAGE_PULL"
  ]
}
